---
import Base from '../layouts/Base.astro';

const night = [
  {
    hour: '21:00',
    title: 'Sesión Acústica & Cerveza Artesanal',
    text: 'Noche de cantautores independientes en el sótano acústico de Malasaña. Degustación de 4 IPAs locales.',
    meta: 'Malasaña, a 1,5 km · 15 €/pers. · abierto ahora',
    img: '/img/event-acoustic.jpg',
    alt: 'Concierto acústico en un sótano de Malasaña',
    live: false,
  },
  {
    hour: '21:30',
    title: 'Rooftop Cibeles',
    text: 'Terraza en la azotea con vistas a la ciudad. El plan que tu grupo está votando ahora mismo.',
    meta: 'Gran Vía, a 1,2 km · 15 €/pers. · 4 de 5 han votado',
    img: '/img/mockup-rooftop.jpg',
    alt: 'Terraza de un rooftop de Madrid al atardecer',
    live: true,
  },
  {
    hour: '11:30',
    title: 'Brunch Botánico en Patio Central',
    text: 'Tostas de masa madre, café de especialidad y repostería en un invernadero urbano histórico.',
    meta: 'Salamanca, a 2,8 km · 18 €/pers. · sábado',
    img: '/img/event-brunch.jpg',
    alt: 'Mesa de brunch en un patio con plantas',
    live: false,
  },
  {
    hour: '20:00',
    title: 'Noche de Micro Abierto & Tacos',
    text: 'Cómicos consolidados probando material nuevo, con cócteles de autor y barra mexicana.',
    meta: 'La Latina, a 0,9 km · 12 €/pers. · domingo',
    img: '/img/event-comedy.jpg',
    alt: 'Cómico actuando ante el público en un local pequeño',
    live: false,
  },
];

const steps = [
  {
    title: 'Descubre o propón',
    text: 'Elige entre cientos de recomendaciones o añade tu propio plan a la lista en segundos.',
  },
  {
    title: 'Comparte y vota',
    text: 'Envía el link al chat. Todos votan con un toque, sin instalar nada ni registrarse.',
  },
  {
    title: 'Disfrutad juntos',
    text: 'Plan confirmado, enlace a Google Maps, recordatorio en calendario y presupuesto estimado.',
  },
];
---

<Base>
  <a class="sr-only" href="#top">Saltar al contenido</a>

  <header class="nav">
    <div class="wrap nav__bar">
      <a class="nav__logo" href="#top">
        <span class="mark mark--initial" aria-hidden="true">M</span>Melia
      </a>
      <nav class="nav__links" aria-label="Principal">
        <a class="nav__link" href="#noche">La noche</a>
        <a class="nav__link" href="#votar">Cómo funciona</a>
        <a class="nav__link" href="#locales">Creadores</a>
      </nav>
      <div class="nav__actions">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar entre tema claro y oscuro"
          class="chip"
        >
          Tema
        </button>
        <a class="btn btn--primary" href="#descargar">Descargar gratis</a>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- HERO · the copy beside the clock, as in direction 03 -->
    <section class="section section--hero hero hero--split" id="descubrir">
      <div class="wrap grid hero-text hero-split">
        <div class="hero-copy span-6">
          <h1 class="hero-text">
            <span class="hl-1">Menos</span>
            <span class="hl-2"><s>“a ver qué hacemos”</s>,</span>
            <span class="hl-1 hl-1--b">más</span>
            <span class="hl-3">¡ya estamos aquí!</span>
          </h1>
          <p class="lead">
            Terrazas, restaurantes y planes en tu ciudad. Vota con tus amigos en
            30 segundos.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#descargar">Descargar gratis</a>
            <a class="btn btn--secondary" href="#noche">Ver la noche entera</a>
          </div>
        </div>

        <div class="hero-visual span-6">
          <div class="clock" id="votar">
            <div class="clock__top">
              <span class="clock__now mono">21:14</span>
              <span class="clock__live">Votación en vivo</span>
            </div>
            <p class="clock__q">
              Tu grupo decide en 12 minutos a dónde van hoy.
            </p>
            <div class="clock__row">
              <span class="clock__hour mono">21:30</span>
              <div>
                <div class="clock__t">Rooftop Cibeles</div>
                <div class="clock__m">Gran Vía, a 1,2 km · 15 €/pers.</div>
                <div class="clock__votes">
                  <span class="av av--on">MR</span>
                  <span class="av av--on">SL</span>
                  <span class="av av--off">AG</span>
                  <span class="av av--off">+2</span>
                  <span>4 de 5 han votado</span>
                </div>
              </div>
            </div>
            <a class="btn btn--primary clock__cta" href="#descargar">¡Me apunto!</a>
          </div>
        </div>
      </div>
    </section>

    <!-- THE NIGHT, hour by hour -->
    <section class="section" id="noche">
      <div class="wrap">
        <div class="section-head section-head--row">
          <h2>Esta noche, hora por hora</h2>
          <p class="lead">
            Lo que está abierto ahora en Madrid, ordenado por lo que empieza antes.
          </p>
        </div>

        <div class="night">
          {
            night.map(({ hour, title, text, meta, img, alt, live }) => (
              <div class:list={['night__row', live && 'night__row--now']}>
                <span class="night__hour mono">{hour}</span>
                <a class="night__slot zoom" href="#noche">
                  <div>
                    <h3 class="t-card">{title}</h3>
                    <p class="t-body">{text}</p>
                    <p class="t-small muted">{meta}</p>
                  </div>
                  <img src={img} alt={alt} loading="lazy" />
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- THREE STEPS -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Tres pasos y ya están en la calle</h2>
        </div>
        <div class="steps">
          {
            steps.map(({ title, text }, i) => (
              <div class="step">
                <span class="step__n mono">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="t-card">{title}</h3>
                <p class="t-body">{text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CLOSING -->
    <section class="section ground-inverse" id="descargar">
      <div class="wrap closing">
        <h2>Tu próxima anécdota empieza este fin de semana.</h2>
        <p class="lead">
          Descarga Melia gratis en iOS o Android y deja de preguntarte qué hacer.
          Sin suscripciones forzadas, 100 % colaborativo para grupos.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="#descargar">App Store</a>
          <a class="btn btn--secondary" href="#descargar">Google Play</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer" id="locales">
    <div class="wrap">
      <div class="grid">
        <div class="span-4">
          <span class="nav__logo" style="padding:0"
            ><span class="mark mark--initial" aria-hidden="true">M</span>Melia</span
          >
          <p class="t-small muted">
            Descubre eventos auténticos, vota salidas con tu grupo y coordina
            planes en minutos.
          </p>
          <p class="t-small muted">
            Disponible en España: Madrid, Barcelona, Valencia, Sevilla.
          </p>
        </div>
        <div class="span-3">
          <p class="t-label">Explorar</p>
          <a href="#noche">Planes destacados</a>
          <a href="#noche">Rutas de fin de semana</a>
          <a href="#noche">Gastronomía</a>
        </div>
        <div class="span-3">
          <p class="t-label">Producto</p>
          <a href="#votar">Votación grupal</a>
          <a href="#noche">Radar urbano</a>
          <a href="#noche">Calendario</a>
        </div>
        <div class="span-2">
          <p class="t-label">Compañía</p>
          <a href="#locales">Red de aliados</a>
          <a href="#locales">Soporte</a>
        </div>
      </div>
      <p class="t-small muted credits" style="margin-top:2rem">
        © 2025 Melia · Español (ES)
      </p>
    </div>
  </footer>

  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const inv = document.documentElement.classList.toggle('theme-inv');
      localStorage.setItem('melia-theme', inv ? 'dark' : 'light');
    });
  </script>
</Base>
