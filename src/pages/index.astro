---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import Features from '../components/Features.astro';
import Radar from '../components/Radar.astro';
import Steps from '../components/Steps.astro';
import Creators from '../components/Creators.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

const metrics = [
  { figure: '+2,4k', label: 'planes activos' },
  { figure: '+180', label: 'ciudades' },
  { figure: '4,9', label: 'valoración en las tiendas' },
];
---

<Base>
  <Header />
  <main class="w-full">
    <Hero />

    <!-- The page's own figures, as one more row of the board. -->
    <section class="w-full border-t border-rule bg-paper">
      <div class="mx-auto w-full max-w-[1200px] px-[var(--gutter)]">
        <dl class="grid grid-cols-3 divide-x divide-rule">
          {
            metrics.map(({ figure, label }) => (
              <div class="flex flex-col gap-0.5 px-[var(--space-md)] py-[var(--space-md)] first:pl-0 last:pr-0">
                <dt class="num text-sm font-medium text-ink">{figure}</dt>
                <dd class="text-[11px] text-muted">{label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <CategoryStrip />
    <Features />
    <Radar />
    <Steps />
    <Creators />
    <FinalCTA />
  </main>
  <Footer />
</Base>
