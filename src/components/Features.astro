---
import Icon from './Icon.astro';

const reasons = [
  {
    icon: 'near_me',
    title: 'Descubrimiento hiperlocal en tiempo real',
    text: 'Filtra por distancia precisa, rango de precio real por persona y lugares con disponibilidad inmediata. Planes curados y verificados a diario.',
  },
  {
    icon: 'how_to_vote',
    title: 'Listas grupales con votación express',
    text: 'Elige 2 o 3 opciones, comparte un enlace rápido y votad con un simple toque. Tus amigos no necesitan registrarse para votar.',
  },
  {
    icon: 'calendar_month',
    title: 'Tu agenda de ocio centralizada',
    text: 'Sincronización instantánea con Google Calendar, Apple Calendar y recordatorios del clima para que nadie llegue tarde o sin plan b.',
  },
];
---

<section class="w-full bg-paper py-[var(--space-4xl,var(--space-3xl))]" id="como-funciona">
  <div class="mx-auto w-full max-w-[1200px] px-[var(--gutter)]">
    <header class="mb-[var(--space-xl)] flex max-w-[46ch] flex-col gap-3">
      <h2 class="text-section text-ink">
        Tres razones para no volver a planear por chat
      </h2>
      <p class="text-ink-2">
        Salir de casa con tus personas favoritas toma dos minutos, sin los
        eternos audios de WhatsApp.
      </p>
    </header>

    <div class="flex flex-col border-b border-rule">
      {
        reasons.map(({ icon, title, text }, i) => (
          <article class="grid grid-cols-1 items-start gap-x-[var(--space-lg)] gap-y-3 border-t border-rule py-[var(--space-lg)] md:grid-cols-12">
            <span class="flex items-center gap-2 md:col-span-1">
              <Icon name={icon} class="text-[20px] text-accent-text" />
            </span>
            <h3 class="text-title text-ink md:col-span-4">{title}</h3>
            <div class="flex flex-col gap-3 md:col-span-7">
              <p class="max-w-[56ch] text-sm text-ink-2">{text}</p>
              {i === 0 && (
                <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-rule pt-2.5 text-xs">
                  <span class="text-muted">Distancia estimada <span class="num ml-1 text-ink">&lt; 800 m</span></span>
                  <span class="flex items-center gap-1.5 text-ink-2">
                    <Icon name="schedule" class="text-[14px] text-accent-text" />
                    Abierto ahora, terraza con mesas libres
                  </span>
                </div>
              )}
              {i === 1 && (
                <div class="flex flex-col gap-1.5 border-t border-rule pt-2.5">
                  <div class="flex items-baseline justify-between text-xs">
                    <span class="text-ink-2">Taberna La Carmencita</span>
                    <span class="num text-ink">75%</span>
                  </div>
                  <div class="h-1 w-full overflow-hidden bg-paper-3">
                    <div class="h-full w-3/4 bg-accent"></div>
                  </div>
                </div>
              )}
              {i === 2 && (
                <div class="flex items-center gap-2 border-t border-rule pt-2.5 text-xs text-ink-2">
                  <Icon name="check_circle" class="text-[15px] text-accent-text" />
                  Sincronización automática, iCal y Google Calendar
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
