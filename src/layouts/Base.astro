---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Melia — Sal sin rodeos',
  description = 'Descubre los mejores lugares en Madrid y decide con tu grupo en 1 toque. Votación en WhatsApp, sin descargas obligatorias y el plan cerrado al instante.',
  image = '/og.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Melia',
  applicationCategory: 'SocialNetworkingApplication',
  operatingSystem: 'iOS, Android, Web',
  description,
  url: canonical.href,
  image: ogImage.href,
  inLanguage: 'es-ES',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  areaServed: { '@type': 'Country', name: 'España' },
};
---

<!doctype html>
<html
  lang="es"
  class="theme-inv"
  data-type="product"
  data-radius="soft"
  data-buttons="solid"
  data-motion
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="page-type" content="product" />
    <meta name="site-kind" content="other" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="es-ES" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Melia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content="Melia — Decide con tu grupo a dónde salir en 1 toque" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#faf7f4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1b1614"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light" />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('melia-theme');
        if (stored === 'dark') document.documentElement.classList.add('theme-inv');
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&family=Figtree:wght@400..600&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
  </head>
  <body>
    <slot />
    <script is:inline defer src="/assets/backgrounds/backgrounds.js"></script>
  </body>
</html>
