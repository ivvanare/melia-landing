  <script>
    // Theme toggle (Sun & Moon)
    const themeBtn = document.getElementById('theme-toggle');
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('theme-inv');
      localStorage.setItem('melia-theme', isDark ? 'dark' : 'light');
      themeBtn.setAttribute('aria-label', isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
      themeBtn.setAttribute('title', isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
    });

    if (document.documentElement.classList.contains('theme-inv') && themeBtn) {
      themeBtn.setAttribute('aria-label', 'Cambiar a tema claro');
      themeBtn.setAttribute('title', 'Cambiar a tema claro');
    }

    // =========================================================================
    // SMART FLOATING NAVBAR (HIDE ON SCROLL DOWN & NEAR FOOTER, SHOW ON SCROLL UP)
    // =========================================================================
    (() => {
      const navHeader = document.querySelector('header.nav') as HTMLElement | null;
      if (!navHeader) return;
      let lastY = window.scrollY;
      let isHidden = false;

      const downloadSec = document.getElementById('descargar');

      function hideNav() {
        if (!isHidden) {
          navHeader.classList.add('nav--hidden');
          navHeader.style.transform = 'translateY(-160%)';
          navHeader.style.opacity = '0';
          navHeader.style.pointerEvents = 'none';
          isHidden = true;
        }
      }

      function showNav() {
        if (isHidden) {
          navHeader.classList.remove('nav--hidden');
          navHeader.style.transform = 'translateY(0)';
          navHeader.style.opacity = '1';
          navHeader.style.pointerEvents = 'none'; // container is non-blocking, inner bar is clickable
          isHidden = false;
        }
      }

      function isOverClosingFooter(): boolean {
        if (!downloadSec) return false;
        const rect = downloadSec.getBoundingClientRect();
        return rect.top <= window.innerHeight - 80;
      }

      // Clicking "Descargar gratis" in navbar instantly hides navbar before smooth scroll arrives
      const downloadNavBtn = document.querySelector('.nav__actions .btn--primary');
      downloadNavBtn?.addEventListener('click', () => {
        hideNav();
      });

      window.addEventListener('scroll', () => {
        const currentY = window.scrollY;
        const diff = currentY - lastY;

        // If user is anywhere near the closing VIP stage, navbar MUST be hidden
        if (isOverClosingFooter()) {
          hideNav();
          lastY = currentY;
          return;
        }

        // Near the absolute top of the page: always show
        if (currentY <= 60) {
          showNav();
        } else if (diff > 6 && currentY > 100) {
          // Scrolling down: tuck navbar away immediately
          hideNav();
        } else if (diff < -8 && isHidden) {
          // Scrolling up: reveal navbar smoothly
          showNav();
        }

        lastY = currentY;
      }, { passive: true });
    })();

    // =========================================================================
    // PARTIFUL-STYLE HERO WIDGET: 4-STATE MACHINE & MICRO-INTERACTIONS
    // =========================================================================
    (() => {
      // Views
      const viewDemo = document.getElementById('view-demo');
      const viewCreator = document.getElementById('view-creator');
      const viewReady = document.getElementById('view-ready');
      const confettiLayer = document.getElementById('confetti-layer');

      function switchView(viewName: 'demo' | 'creator' | 'ready') {
        if (viewDemo) viewDemo.setAttribute('data-active', viewName === 'demo' ? 'true' : 'false');
        if (viewCreator) viewCreator.setAttribute('data-active', viewName === 'creator' ? 'true' : 'false');
        if (viewReady) viewReady.setAttribute('data-active', viewName === 'ready' ? 'true' : 'false');
      }

      // Hero primary button connects to widget creator sandbox
      const heroCreateBtn = document.getElementById('hero-create-btn');
      heroCreateBtn?.addEventListener('click', () => {
        switchView('creator');
        document.getElementById('votar')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('input-plan-title')?.focus();
      });

      document.getElementById('btn-to-creator')?.addEventListener('click', () => {
        switchView('creator');
        document.getElementById('input-plan-title')?.focus();
      });

      document.getElementById('btn-creator-back')?.addEventListener('click', () => {
        switchView('demo');
      });

      document.getElementById('btn-ready-reset')?.addEventListener('click', () => {
        switchView('demo');
      });

      // 3D Perspective Tilt on Mousemove (Rootline HorizonX)
      const tiltCard = document.getElementById('poll-card-tilt');
      if (tiltCard && window.matchMedia('(hover: hover)').matches) {
        tiltCard.addEventListener('mousemove', (e) => {
          const rect = tiltCard.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          tiltCard.style.transform = `perspective(1000px) rotateY(${x * 9}deg) rotateX(${-y * 9}deg)`;
        });
        tiltCard.addEventListener('mouseleave', () => {
          tiltCard.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
        });
      }

      // Quick chips suggestions in creator form
      const chips = document.querySelectorAll('.quick-chip');
      const opt2Input = document.getElementById('input-opt-2') as HTMLInputElement | null;
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const val = chip.getAttribute('data-val');
          if (opt2Input && val) {
            opt2Input.value = val;
            opt2Input.focus();
          }
        });
      });

      // Timer pills selector
      const timerPills = document.querySelectorAll('.timer-pill');
      timerPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          timerPills.forEach((p) => p.setAttribute('aria-selected', 'false'));
          pill.setAttribute('aria-selected', 'true');
        });
      });

      // Generate link in Creator mode
      document.getElementById('btn-submit-create')?.addEventListener('click', () => {
        const titleInput = (document.getElementById('input-plan-title') as HTMLInputElement)?.value || 'Salida de viernes';
        const opt1 = (document.getElementById('input-opt-1') as HTMLInputElement)?.value || 'Opción 1';
        const opt2 = (document.getElementById('input-opt-2') as HTMLInputElement)?.value || 'Opción 2';

        // Update live poll labels
        const heading = document.getElementById('poll-title-heading');
        if (heading && titleInput) heading.textContent = titleInput;
        const opt1Title = document.getElementById('opt-cibeles-title');
        if (opt1Title && opt1) opt1Title.textContent = opt1;
        const opt2Title = document.getElementById('opt-malasana-title');
        if (opt2Title && opt2) opt2Title.textContent = opt2;

        // Reset votes for fresh plan
        state.counts.cibeles = 1;
        state.counts.malasana = 0;
        state.userVote = 'cibeles';
        updateDemoUI();

        const randomSlug = 'viernes-' + Math.floor(Math.random() * 89 + 10) + 'x';
        const urlText = document.getElementById('ready-url-text');
        const waTitle = document.getElementById('ready-wa-title');
        const waPreview = document.getElementById('ready-wa-preview');

        if (urlText) urlText.textContent = `melia.app/v/${randomSlug}`;
        if (waTitle) waTitle.textContent = `${titleInput}: ${opt1} vs ${opt2}`;
        if (waPreview) waPreview.textContent = `¡Gente! Voten rápido el plan para hoy: ${titleInput} 👇`;

        switchView('ready');
        spawnEmojis('🎉', 8);
        launchConfetti(confettiLayer, ['🎉', '🚀', '🔥', '✨']);

        const footerMsg = document.getElementById('poll-footer-msg');
        if (footerMsg) {
          footerMsg.innerHTML = `<strong style="color:var(--p-accent); font-weight:700;">🔗 Link listo:</strong> melia.app/v/${randomSlug}`;
        }
      });

      // Copy helpers in Ready mode
      function copyGeneratedLink(btnElement?: HTMLElement | null) {
        const slug = document.getElementById('ready-url-text')?.textContent || 'melia.app/v/viernes';
        if (navigator.clipboard) {
          navigator.clipboard.writeText(`https://${slug}`).catch(() => {});
        }
        if (btnElement) {
          const original = btnElement.textContent;
          btnElement.textContent = '¡Enlace copiado! 🚀';
          setTimeout(() => {
            btnElement.textContent = original;
          }, 2000);
        }
      }

      document.getElementById('ready-copy-inline')?.addEventListener('click', (e) => {
        copyGeneratedLink(e.currentTarget as HTMLElement);
      });
      document.getElementById('btn-ready-copy-main')?.addEventListener('click', (e) => {
        copyGeneratedLink(e.currentTarget as HTMLElement);
      });

      // LIVESTREAM FLOATING EMOJIS & CONFETTI ENGINE
      function spawnEmojis(symbol: string, count = 5) {
        const stage = document.getElementById('emoji-stage');
        if (!stage) return;
        for (let i = 0; i < count; i++) {
          const span = document.createElement('span');
          span.textContent = symbol;
          span.className = 'floating-emoji';
          span.style.left = `${15 + Math.random() * 70}%`;
          span.style.animationDelay = `${i * 0.08}s`;
          stage.appendChild(span);
          setTimeout(() => span.remove(), 1300);
        }
      }

      function launchConfetti(container: HTMLElement | null, emojis: string[]) {
        if (!container) return;
        for (let i = 0; i < 8; i++) {
          const span = document.createElement('span');
          span.className = 'emoji-burst';
          span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          span.style.left = `${30 + Math.random() * 40}%`;
          span.style.top = `${40 + Math.random() * 20}%`;
          span.style.setProperty('--tx', `${(Math.random() - 0.5) * 120}px`);
          span.style.setProperty('--ty', `${-60 - Math.random() * 80}px`);
          span.style.setProperty('--tr', `${(Math.random() - 0.5) * 60}deg`);
          container.appendChild(span);
          setTimeout(() => span.remove(), 1200);
        }
      }

      // STATE 1: DEMO VIVA INTERACTION
      const state = {
        userVote: null as 'cibeles' | 'malasana' | null,
        counts: { cibeles: 3, malasana: 2 },
      };

      const optCibeles = document.getElementById('opt-cibeles');
      const optMalasana = document.getElementById('opt-malasana');
      const barCibeles = document.getElementById('bar-cibeles');
      const barMalasana = document.getElementById('bar-malasana');
      const countCibeles = document.getElementById('count-cibeles');
      const countMalasana = document.getElementById('count-malasana');
      const btnCibeles = document.getElementById('btn-cibeles');
      const btnMalasana = document.getElementById('btn-malasana');
      const avsCibeles = document.getElementById('avs-cibeles');
      const avsMalasana = document.getElementById('avs-malasana');
      const toast = document.getElementById('ballot-toast');
      const toastMsg = document.getElementById('toast-msg');

      function updateDemoUI() {
        const total = state.counts.cibeles + state.counts.malasana;
        const pctCibeles = Math.round((state.counts.cibeles / total) * 100);
        const pctMalasana = 100 - pctCibeles;

        if (barCibeles) barCibeles.style.width = `${pctCibeles}%`;
        if (barMalasana) barMalasana.style.width = `${pctMalasana}%`;

        if (countCibeles) countCibeles.textContent = `${state.counts.cibeles} votos (${pctCibeles}%)`;
        if (countMalasana) countMalasana.textContent = `${state.counts.malasana} votos (${pctMalasana}%)`;

        const cibelesWins = state.counts.cibeles >= state.counts.malasana;
        optCibeles?.setAttribute('data-leader', cibelesWins ? 'true' : 'false');
        optMalasana?.setAttribute('data-leader', !cibelesWins ? 'true' : 'false');

        // Cibeles
        if (state.userVote === 'cibeles') {
          optCibeles?.setAttribute('data-voted', 'true');
          optCibeles?.setAttribute('aria-pressed', 'true');
          if (btnCibeles) btnCibeles.textContent = '✓ Tu voto';
          if (avsCibeles && !avsCibeles.querySelector('.ballot__av--you')) {
            const youAv = document.createElement('span');
            youAv.className = 'ballot__av ballot__av--you';
            youAv.textContent = 'Tú';
            avsCibeles.appendChild(youAv);
          }
        } else {
          optCibeles?.removeAttribute('data-voted');
          optCibeles?.setAttribute('aria-pressed', 'false');
          if (btnCibeles) btnCibeles.textContent = 'Votar';
          avsCibeles?.querySelector('.ballot__av--you')?.remove();
        }

        // Malasaña
        if (state.userVote === 'malasana') {
          optMalasana?.setAttribute('data-voted', 'true');
          optMalasana?.setAttribute('aria-pressed', 'true');
          if (btnMalasana) btnMalasana.textContent = '✓ Tu voto';
          if (avsMalasana && !avsMalasana.querySelector('.ballot__av--you')) {
            const youAv = document.createElement('span');
            youAv.className = 'ballot__av ballot__av--you';
            youAv.textContent = 'Tú';
            avsMalasana.appendChild(youAv);
          }
        } else {
          optMalasana?.removeAttribute('data-voted');
          optMalasana?.setAttribute('aria-pressed', 'false');
          if (btnMalasana) btnMalasana.textContent = 'Votar';
          avsMalasana?.querySelector('.ballot__av--you')?.remove();
        }

        if (toast && toastMsg) {
          if (state.userVote) {
            toast.style.display = 'flex';
            toastMsg.textContent = state.userVote === 'cibeles'
              ? '¡Sumaste tu voto a Rooftop Cibeles! Sin instalar apps ni registro previo.'
              : '¡Sumaste tu voto a Tacos & Acústico! Así de simple resuelve tu grupo.';
          } else {
            toast.style.display = 'none';
          }
        }
      }

      function handleVote(choice: 'cibeles' | 'malasana', el?: HTMLElement | null) {
        if (state.userVote === choice) {
          state.counts[choice]--;
          state.userVote = null;
        } else {
          if (state.userVote) {
            state.counts[state.userVote]--;
          }
          state.userVote = choice;
          state.counts[choice]++;
          spawnEmojis(choice === 'cibeles' ? '🍸' : '🌮', 6);
          launchConfetti(confettiLayer, choice === 'cibeles' ? ['🍸', '✨', '🔥'] : ['🌮', '🎸', '🔥']);
        }
        updateDemoUI();
      }

      optCibeles?.addEventListener('click', () => handleVote('cibeles', optCibeles));
      optMalasana?.addEventListener('click', () => handleVote('malasana', optMalasana));

      // Vibe buttons reaction
      const vibeButtons = document.querySelectorAll('.vibe-btn');
      vibeButtons.forEach((vbtn) => {
        vbtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const emoji = vbtn.getAttribute('data-emoji') || '🔥';
          spawnEmojis(emoji, 6);
          launchConfetti(confettiLayer, [emoji, emoji, '✨']);
          vbtn.setAttribute('data-active', 'true');
          setTimeout(() => vbtn.removeAttribute('data-active'), 1500);
        });
      });

      // Live countdown timer simulation
      let totalSeconds = 14 * 60 + 58;
      const timerEl = document.getElementById('ballot-timer');
      setInterval(() => {
        if (totalSeconds > 0) {
          totalSeconds--;
          const m = Math.floor(totalSeconds / 60);
          const s = totalSeconds % 60;
          if (timerEl) {
            timerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} restantes`;
          }
        }
      }, 1000);

      // Subtle simulated friend vote every 10s if user hasn't interacted
      let simVotes = 0;
      setInterval(() => {
        if (!state.userVote && simVotes < 3) {
          simVotes++;
          if (simVotes % 2 === 1) {
            state.counts.cibeles++;
          } else {
            state.counts.malasana++;
          }
          updateDemoUI();
        }
      }, 10000);

      // Add from Flyer to Hero Poll Creator
      const addPollButtons = document.querySelectorAll('.btn-add-poll');
      addPollButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const title = btn.getAttribute('data-add-title');
          btn.setAttribute('data-added', 'true');
          const label = btn.querySelector('.btn-add-label');
          if (label) label.textContent = '✓ ¡Añadido!';

          if (opt2Input && title) {
            opt2Input.value = title;
          }

          switchView('creator');
          document.getElementById('votar')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          launchConfetti(confettiLayer, ['🎯', '✨', '🔥']);

          setTimeout(() => {
            btn.removeAttribute('data-added');
            if (label) label.textContent = 'Añadir a votación';
          }, 3000);
        });
      });
    })();

    // =========================================================================
    // PATTERN 1: TYPOGRAPHIC LIST HOVER & INTERACTION
    // =========================================================================
    (() => {
      const typoRows = document.querySelectorAll('.typo-row');
      typoRows.forEach((row) => {
        row.addEventListener('mouseenter', () => {
          typoRows.forEach((r) => {
            r.setAttribute('data-active', 'false');
            r.setAttribute('aria-pressed', 'false');
          });
          row.setAttribute('data-active', 'true');
          row.setAttribute('aria-pressed', 'true');
        });

        row.addEventListener('click', () => {
          typoRows.forEach((r) => {
            r.setAttribute('data-active', 'false');
            r.setAttribute('aria-pressed', 'false');
          });
          row.setAttribute('data-active', 'true');
          row.setAttribute('aria-pressed', 'true');
        });
      });
    })();

    // =========================================================================
    // PATTERN 2: STICKY SCROLL STORYTELLING ENGINE (FLUID & TACTILE)
    // =========================================================================
    (() => {
      const storySec = document.getElementById('como-funciona');
      const storyBadge = document.getElementById('story-badge');
      const storyTitle = document.getElementById('story-title');
      const storyDesc = document.getElementById('story-desc');
      const storyCta = document.getElementById('story-cta');
      const iphoneFrame = document.getElementById('iphone-frame');
      const trackFill = document.getElementById('story-track-fill');
      const scenes = [
        document.getElementById('phone-scene-0'),
        document.getElementById('phone-scene-1'),
        document.getElementById('phone-scene-2'),
        document.getElementById('phone-scene-3'),
      ];
      const dockBtns = document.querySelectorAll('.story-progress-btn');

      const storySteps = [
        {
          badge: 'EL PROBLEMA',
          title: 'BASTA DE DEBATES ETERNOS',
          desc: '40 mensajes cruzados, 3 audios sin escuchar y las 22:45... Siguen todos en el sofá discutiendo sin plan.',
          cta: 'Ver la solución de Melia ↓',
        },
        {
          badge: 'PASO 01',
          title: '01. ELIGE 2 O 3 OPCIONES',
          desc: 'Explora terrazas, cócteles o picoteo cerca de ti y arma la votación para tu grupo en 15 segundos.',
          cta: 'Probar crear sala ahora ✨',
        },
        {
          badge: 'PASO 02',
          title: '02. MANDA EL LINK AL GRUPO',
          desc: 'Tus amigos votan con un toque desde Safari o Chrome. Sin descargar apps ni crear cuentas obligatorias.',
          cta: 'Ver cómo votan en vivo →',
        },
        {
          badge: 'PASO 03',
          title: '03. PLAN CERRADO Y A LA CALLE',
          desc: 'Al cumplirse el temporizador, gana el favorito. Todos reciben punto de encuentro en Maps y mesa confirmada.',
          cta: 'Crear plan con amigos ✨',
        },
      ];

      let activePhase = -1;

      function setPhase(idx: number) {
        if (idx === activePhase || idx < 0 || idx > 3) return;
        const prevPhase = activePhase;
        activePhase = idx;
        const data = storySteps[idx];

        // 1. Directional Scene transitions (past vs active vs future)
        scenes.forEach((sc, i) => {
          if (!sc) return;
          if (i === idx) {
            sc.setAttribute('data-active', 'true');
            sc.setAttribute('data-past', 'false');
          } else if (i < idx) {
            sc.setAttribute('data-active', 'false');
            sc.setAttribute('data-past', 'true');
          } else {
            sc.setAttribute('data-active', 'false');
            sc.setAttribute('data-past', 'false');
          }
        });

        // 2. Dynamic glow state on iPhone
        if (iphoneFrame) {
          iphoneFrame.setAttribute('data-glow', String(idx));
        }

        // 3. Smooth text crossfade
        const leftCol = document.querySelector('.story-col-left');
        const rightCol = document.querySelector('.story-col-right');

        if (prevPhase !== -1 && leftCol && rightCol) {
          leftCol.classList.add('is-swapping');
          rightCol.classList.add('is-swapping');
          setTimeout(() => {
            if (storyBadge) storyBadge.textContent = data.badge;
            if (storyTitle) storyTitle.textContent = data.title;
            if (storyDesc) storyDesc.textContent = data.desc;
            if (storyCta) {
              const span = storyCta.querySelector('span');
              if (span) span.textContent = data.cta;
            }
            leftCol.classList.remove('is-swapping');
            rightCol.classList.remove('is-swapping');
          }, 140);
        } else {
          if (storyBadge) storyBadge.textContent = data.badge;
          if (storyTitle) storyTitle.textContent = data.title;
          if (storyDesc) storyDesc.textContent = data.desc;
          if (storyCta) {
            const span = storyCta.querySelector('span');
            if (span) span.textContent = data.cta;
          }
        }

        // 4. Update Dock Buttons
        dockBtns.forEach((btn, i) => {
          btn.setAttribute('data-active', i === idx ? 'true' : 'false');
        });
      }

      let ticking = false;

      function updateStory() {
        if (!storySec) return;
        // On mobile (< 1024px), section is an interactive compact showcase with tabs, not sticky scroll
        if (window.innerWidth < 1024) return;

        const rect = storySec.getBoundingClientRect();
        const total = storySec.offsetHeight - window.innerHeight;
        if (total <= 0) return;

        const progress = Math.min(Math.max(-rect.top / total, 0), 1);

        // Continuous progress fill
        if (trackFill) {
          trackFill.style.height = `${(progress * 100).toFixed(1)}%`;
        }

        // Tactile micro-parallax on the iPhone frame
        if (iphoneFrame) {
          const parallax = (progress - 0.5) * 18;
          iphoneFrame.style.transform = `translateY(${parallax.toFixed(1)}px)`;
        }

        // Continuous vote bar fill in Phase 2
        if (progress >= 0.48 && progress <= 0.76) {
          const subP = (progress - 0.48) / (0.76 - 0.48);
          const fillPercent = Math.min(Math.max(Math.round(20 + subP * 48), 20), 68);
          const barEl = document.querySelector('.bar-cibeles-fill') as HTMLElement | null;
          const voteTextEl = document.getElementById('scene-cibeles-pct');
          if (barEl) barEl.style.width = `${fillPercent}%`;
          if (voteTextEl) voteTextEl.textContent = `${fillPercent}%`;
        }

        // Determine current phase with comfortable zones
        let phase = 0;
        if (progress < 0.25) phase = 0;
        else if (progress < 0.50) phase = 1;
        else if (progress < 0.75) phase = 2;
        else phase = 3;

        setPhase(phase);
        ticking = false;
      }

      function handleStoryScroll() {
        if (!ticking) {
          requestAnimationFrame(updateStory);
          ticking = true;
        }
      }

      window.addEventListener('scroll', handleStoryScroll, { passive: true });
      window.addEventListener('resize', handleStoryScroll, { passive: true });
      setPhase(0);
      updateStory();

      dockBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const stepIdx = parseInt(btn.getAttribute('data-step-idx') || '0', 10);
          setPhase(stepIdx);

          if (window.innerWidth >= 1024 && storySec) {
            const total = storySec.offsetHeight - window.innerHeight;
            const targetY = storySec.offsetTop + (stepIdx * 0.25 * total) + 20;
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        });
      });

      storyCta?.addEventListener('click', (e) => {
        if (activePhase < 3) {
          e.preventDefault();
          const nextIdx = activePhase + 1;
          setPhase(nextIdx);

          if (window.innerWidth >= 1024 && storySec) {
            const total = storySec.offsetHeight - window.innerHeight;
            const targetY = storySec.offsetTop + (nextIdx * 0.25 * total) + 20;
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        }
      });
    })();

    // =========================================================================
    // FOOTER BRAND WATERMARK CIRCULAR SPOTLIGHT & RELIEF EFFECT
    // =========================================================================
    (() => {
      const brandStage = document.querySelector('.footer-brand-stage') as HTMLElement | null;
      if (!brandStage) return;

      brandStage.addEventListener('mousemove', (e) => {
        const rect = brandStage.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        brandStage.style.setProperty('--mouse-x', `${x}px`);
        brandStage.style.setProperty('--mouse-y', `${y}px`);
      });

      brandStage.addEventListener('mouseleave', () => {
        brandStage.style.setProperty('--mouse-x', '-9999px');
        brandStage.style.setProperty('--mouse-y', '-9999px');
      });
    })();
  </script>
</Base>
