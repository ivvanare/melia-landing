---
import Icon from './Icon.astro';
import EventCard from './EventCard.astro';
import FilterFeedback from './FilterFeedback.astro';

const events = [
  {
    image: '/img/event-acoustic.jpg',
    alt: 'Concierto acústico indie',
    category: 'Música en vivo',
    badge: 'Tendencia hoy',
    time: 'Abierto ahora, 21:00',
    price: '15 € / pers.',
    title: 'Sesión Acústica & Cerveza Artesanal',
    description:
      'Noche de cantautores independientes en el sótano acústico de Malasaña. Ambiente íntimo y degustación de 4 IPAs locales.',
    location: 'Malasaña, a 1,5 km',
  },
  {
    image: '/img/event-brunch.jpg',
    alt: 'Brunch botánico',
    category: 'Brunch & Café',
    badge: 'Pet friendly',
    time: 'Sábado, 11:30',
    price: '18 € / pers.',
    title: 'Brunch Botánico en Patio Central',
    description:
      'Tostas de masa madre, café de especialidad infusionado en frío y repostería en un invernadero urbano histórico.',
    location: 'Salamanca, a 2,8 km',
  },
  {
    image: '/img/event-comedy.jpg',
    alt: 'Micro abierto y monólogos',
    category: 'Comedia & Show',
    badge: 'Últimas 8 entradas',
    time: 'Domingo, 20:00',
    price: '12 € / pers.',
    title: 'Noche de Micro Abierto & Tacos',
    description:
      'Cómicos consolidados probando material nuevo acompañados de cócteles de autor y barra mexicana.',
    location: 'La Latina, a 0,9 km',
  },
];
---

<section
  class="w-full border-t border-rule bg-paper-2 py-[var(--space-4xl,var(--space-3xl))]"
  id="mapa-en-vivo"
>
  <div class="mx-auto w-full max-w-[1200px] px-[var(--gutter)]">
    <div
      class="mb-[var(--space-lg)] flex flex-col justify-between gap-4 md:flex-row md:items-end"
    >
      <h2 class="max-w-[24ch] text-section text-ink">
        Planes recomendados para este fin de semana
      </h2>
      <div
        role="group"
        aria-label="Rango de fechas"
        class="inline-flex self-start rounded-pill border border-rule p-1 md:self-auto"
      >
        {
          ['Hoy', 'Este fin de semana', 'Próxima semana'].map((label, i) => (
            <button
              type="button"
              data-time={label}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="time-pill cursor-pointer whitespace-nowrap rounded-pill px-4 py-3.5 text-xs font-medium transition-colors"
            >
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <FilterFeedback />

    <div class="grid grid-cols-1 gap-[var(--space-lg)] lg:grid-cols-12">
      <!-- Map: the live picture of the neighbourhood -->
      <div
        class="grained relative flex min-h-[260px] flex-col justify-between overflow-hidden rounded-card border border-rule bg-paper-3 p-[var(--space-lg)] lg:col-span-5"
      >
        <div class="flex flex-col gap-2">
          <span class="flex items-baseline gap-2">
            <span class="num text-3xl text-accent-text">42</span>
            <span class="text-sm text-ink-2">planes y mesas activas a &lt; 2 km</span>
          </span>
          <div class="flex items-center gap-2">
            <Icon name="verified" class="text-[15px] text-accent-text" />
            <h3 class="text-title text-ink">Explora tu barrio en tiempo real</h3>
          </div>
          <p class="max-w-[40ch] text-sm text-ink-2">
            Afluencia estimada, horas felices y mesas libres en locales
            verificados de Madrid.
          </p>
        </div>
        <div class="relative mt-4 h-40 overflow-hidden rounded-[8px] border border-rule">
          <div
            class="h-full w-full bg-cover bg-center"
            style="background-image: url('/img/map-madrid.png')"
          >
          </div>
          <div class="absolute inset-0 bg-paper/25"></div>
          <span
            class="absolute left-1/3 top-1/4 rounded-pill bg-accent px-2 py-0.5 text-[11px] font-medium text-accent-ink"
            >Cibeles</span
          >
          <span
            class="absolute bottom-1/3 right-1/4 rounded-pill bg-paper/90 px-2 py-0.5 text-[11px] font-medium text-ink"
            >Malasaña</span
          >
          <div
            class="absolute inset-x-2 bottom-2 flex items-center justify-between rounded-pill bg-paper/95 px-3 py-1.5 text-[11px] text-ink backdrop-blur-sm"
          >
            <span>Centro</span>
            <a
              class="font-medium text-accent-text underline decoration-accent/40 underline-offset-2"
              href="#mapa-en-vivo">Abrir mapa</a
            >
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <EventCard {...events[0]} featured />
      </div>

      <div class="lg:col-span-6"><EventCard {...events[1]} /></div>
      <div class="lg:col-span-6"><EventCard {...events[2]} /></div>
    </div>
  </div>
</section>
