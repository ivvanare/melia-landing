---
import Icon from './Icon.astro';
import EventCard from './EventCard.astro';
import FilterFeedback from './FilterFeedback.astro';

const events = [
  {
    image: '/img/event-acoustic.jpg',
    alt: 'Concierto acústico indie',
    category: 'Música en vivo',
    badge: 'Tendencia hoy',
    time: '21:00, abierto ahora',
    price: '15 € / pers.',
    title: 'Sesión Acústica & Cerveza Artesanal',
    description:
      'Noche de cantautores independientes en el sótano acústico de Malasaña. Ambiente íntimo y degustación de 4 IPAs locales.',
    location: 'Malasaña, a 1,5 km',
  },
  {
    image: '/img/event-brunch.jpg',
    alt: 'Brunch botánico',
    category: 'Brunch & Café',
    badge: 'Pet friendly',
    time: '11:30, sábado',
    price: '18 € / pers.',
    title: 'Brunch Botánico en Patio Central',
    description:
      'Tostas de masa madre, café de especialidad infusionado en frío y repostería en un invernadero urbano histórico.',
    location: 'Salamanca, a 2,8 km',
  },
  {
    image: '/img/event-comedy.jpg',
    alt: 'Micro abierto y monólogos',
    category: 'Comedia & Show',
    badge: 'Últimas 8 entradas',
    time: '20:00, domingo',
    price: '12 € / pers.',
    title: 'Noche de Micro Abierto & Tacos',
    description:
      'Cómicos consolidados probando material nuevo acompañados de cócteles de autor y barra mexicana.',
    location: 'La Latina, a 0,9 km',
  },
];
---

<section
  class="w-full border-t border-rule bg-paper py-[var(--space-2xl)]"
  id="mapa-en-vivo"
>
  <div class="mx-auto w-full max-w-[1200px] px-[var(--gutter)]">
    <div
      class="mb-[var(--space-lg)] flex flex-col justify-between gap-4 md:flex-row md:items-end"
    >
      <div class="flex flex-col gap-2">
        <h2 class="max-w-[26ch] text-section text-ink">
          Planes recomendados para este fin de semana
        </h2>
        <p class="max-w-[54ch] text-sm text-ink-2">
          42 planes y mesas activas a menos de 2 km, en locales verificados de
          Madrid.
        </p>
      </div>
      <div
        role="group"
        aria-label="Rango de fechas"
        class="inline-flex self-start border border-rule md:self-auto"
      >
        {
          ['Hoy', 'Este fin de semana', 'Próxima semana'].map((label, i) => (
            <button
              type="button"
              data-time={label}
              aria-pressed={i === 1 ? 'true' : 'false'}
              class="time-pill cursor-pointer whitespace-nowrap px-4 py-3.5 text-xs font-medium transition-colors"
            >
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <FilterFeedback />

    <!-- The board -->
    <div class="border-b border-rule">
      <div
        class="hidden grid-cols-12 gap-x-5 border-b border-rule pb-2 text-[11px] text-muted md:grid"
      >
        <span class="col-span-2">hora</span>
        <span class="col-span-5">salida</span>
        <span class="col-span-2">local</span>
        <span class="col-span-3 text-right">estado</span>
      </div>
      <div class="relative">
        <span
          class="pointer-events-none absolute inset-x-0 -top-px z-10 flex items-center gap-2"
          aria-hidden="true"
        >
          <span class="h-px flex-1 bg-accent"></span>
          <span class="num rounded-pill bg-accent px-2 py-0.5 text-[10px] font-medium text-accent-ink"
            >21:14</span
          >
        </span>
      </div>
      {events.map((event) => <EventCard {...event} />)}
    </div>

    <!-- The map, as the board's own footnote -->
    <div class="mt-[var(--space-lg)] grid grid-cols-1 gap-[var(--space-lg)] md:grid-cols-12">
      <div class="flex flex-col gap-2 md:col-span-7">
        <div class="flex items-center gap-2">
          <Icon name="verified" class="text-[15px] text-accent-text" />
          <h3 class="text-title text-ink">Explora tu barrio en tiempo real</h3>
        </div>
        <p class="max-w-[52ch] text-sm text-ink-2">
          Afluencia estimada, horas felices y mesas libres. A pie o en metro.
        </p>
        <dl class="mt-2 flex flex-col border-t border-rule">
          <div class="flex items-baseline justify-between gap-4 border-b border-rule py-2.5">
            <dt class="text-xs text-muted">Cibeles</dt>
            <dd class="num text-sm text-ink">mesas libres</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-rule py-2.5">
            <dt class="text-xs text-muted">Malasaña</dt>
            <dd class="num text-sm text-ink">hora feliz hasta las 23:00</dd>
          </div>
        </dl>
        <a
          class="mt-2 inline-flex w-fit items-center gap-1.5 text-sm font-medium text-ink-2 underline decoration-accent/50 underline-offset-4 transition-colors hover:text-accent"
          href="#mapa-en-vivo"
          >Abrir el mapa
          <Icon name="arrow_forward" class="text-[15px]" /></a
        >
      </div>
      <div class="md:col-span-5">
        <div class="relative aspect-[4/3] w-full overflow-hidden border border-rule">
          <div
            class="h-full w-full bg-cover bg-center"
            style="background-image: url('/img/map-madrid.png')"
          >
          </div>
          <div class="absolute inset-0 bg-paper/25"></div>
          <span
            class="absolute left-1/4 top-1/4 rounded-pill bg-accent px-2 py-1 text-[11px] font-medium text-accent-ink"
            >Cibeles</span
          >
          <span
            class="absolute bottom-1/3 right-1/4 rounded-pill bg-paper/90 px-2 py-1 text-[11px] font-medium text-ink"
            >Malasaña</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
