---
interface Props {
  name: string;
  class?: string;
  fill?: boolean;
}

const { name, class: className = '', fill = false } = Astro.props;
---

<span
  class:list={['material-symbols-outlined', className]}
  aria-hidden="true"
  focusable="false"
  style={fill ? "font-variation-settings: 'FILL' 1;" : undefined}>{name}</span
>
