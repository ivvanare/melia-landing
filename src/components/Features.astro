---
import Icon from './Icon.astro';

const reasons = [
  {
    icon: 'near_me',
    title: 'Descubrimiento hiperlocal en tiempo real',
    text: 'Filtra por distancia precisa, rango de precio real por persona y lugares con disponibilidad inmediata. Planes curados y verificados a diario.',
  },
  {
    icon: 'how_to_vote',
    title: 'Listas grupales con votación express',
    text: 'Elige 2 o 3 opciones, comparte un enlace rápido y votad con un simple toque. Tus amigos no necesitan registrarse para votar.',
  },
  {
    icon: 'calendar_month',
    title: 'Tu agenda de ocio centralizada',
    text: 'Sincronización instantánea con Google Calendar, Apple Calendar y recordatorios del clima para que nadie llegue tarde o sin plan b.',
  },
];
---

<section class="w-full bg-paper py-[var(--space-4xl,var(--space-3xl))]" id="como-funciona">
  <div class="mx-auto w-full max-w-[1200px] px-[var(--gutter)]">
    <header class="mb-[var(--space-xl)] flex max-w-[46ch] flex-col gap-3">
      <h2 class="text-section text-ink">
        Tres razones para no volver a planear por chat
      </h2>
      <p class="text-ink-2">
        Salir de casa con tus personas favoritas toma dos minutos, sin los
        eternos audios de WhatsApp.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-[var(--space-lg)] lg:grid-cols-12">
      <!-- Big cell -->
      <article
        class="flex flex-col justify-between gap-6 rounded-card border border-rule bg-paper-2 p-[var(--space-xl)] lg:col-span-7"
      >
        <div class="flex flex-col gap-3">
          <span
            class="flex h-11 w-11 items-center justify-center rounded-pill border border-rule text-accent-text"
          >
            <Icon name={reasons[0].icon} class="text-[22px]" />
          </span>
          <h3 class="text-title text-ink">{reasons[0].title}</h3>
          <p class="max-w-[52ch] text-sm text-ink-2">{reasons[0].text}</p>
        </div>

        <div class="flex flex-col gap-2 border-t border-rule pt-4">
          <div class="flex items-baseline justify-between text-xs text-muted">
            <span>Distancia estimada</span>
            <span class="num text-lg text-ink">&lt; 800 m</span>
          </div>
          <div class="h-1 w-full overflow-hidden rounded-pill bg-paper-3">
            <div class="h-full w-2/5 rounded-pill bg-accent"></div>
          </div>
          <span class="flex items-center gap-1.5 pt-1 text-xs text-ink-2">
            <Icon name="schedule" class="text-[15px] text-accent-text" />
            Abierto ahora, terraza con mesas libres
          </span>
        </div>
      </article>

      <!-- Two stacked cells -->
      <div class="flex flex-col gap-[var(--space-lg)] lg:col-span-5">
        {
          reasons.slice(1).map(({ icon, title, text }, i) => (
            <article class="flex flex-1 flex-col justify-between gap-3 rounded-card border border-rule bg-paper-2 p-[var(--space-lg)]">
              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-pill border border-rule text-accent-text">
                    <Icon name={icon} class="text-[18px]" />
                  </span>
                  <h3 class="text-lg text-ink">{title}</h3>
                </div>
                <p class="text-sm text-ink-2">{text}</p>
              </div>
              {i === 0 ? (
                <div class="border-t border-rule pt-3">
                  <div class="flex items-baseline justify-between text-xs text-muted">
                    <span>¿Tapas en Latina o Ramen?</span>
                    <span class="text-ink-2">4 votos</span>
                  </div>
                  <div class="mt-1.5 flex items-baseline justify-between text-[11px] text-ink-2">
                    <span>Taberna La Carmencita</span>
                    <span class="num text-ink">75%</span>
                  </div>
                  <div class="mt-1 h-1 w-full overflow-hidden rounded-pill bg-paper-3">
                    <div class="h-full w-3/4 rounded-pill bg-accent"></div>
                  </div>
                </div>
              ) : (
                <div class="flex items-center gap-2 border-t border-rule pt-3 text-xs text-ink-2">
                  <Icon name="check_circle" class="text-[16px] text-accent-text" />
                  Sincronización automática, iCal y Google Calendar
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
