---
import Base from '../layouts/Base.astro';

const zones = [
  {
    id: 'rooftops',
    name: 'Rooftops en Gran Vía',
    count: 12,
    active: true,
    flyerLeft: {
      title: 'Rooftop Cibeles & Sunset',
      vibe: '🔥 Trending hoy',
      price: '15 €/pers.',
      friendsCount: 5,
      img: '/img/mockup-rooftop.jpg',
      alt: 'Terraza de un rooftop de Madrid al atardecer',
      tilt: '-3.5deg',
    },
    flyerRight: {
      title: 'Terraza Círculo de Bellas Artes',
      vibe: '🍸 Vistas 360°',
      price: '18 €/pers.',
      friendsCount: 4,
      img: '/img/night-street.jpg',
      alt: 'Vistas panorámicas nocturnas de Gran Vía',
      tilt: '3.5deg',
    },
  },
  {
    id: 'malasana',
    name: 'Malasaña & Conde Duque',
    count: 18,
    active: false,
    flyerLeft: {
      title: 'Sesión Acústica & IPAs',
      vibe: '🎸 Música en vivo',
      price: '14 €/pers.',
      friendsCount: 3,
      img: '/img/event-acoustic.jpg',
      alt: 'Concierto acústico en sótano de Malasaña',
      tilt: '-2.5deg',
    },
    flyerRight: {
      title: 'Tapas de Autor & Vermut',
      vibe: '🍻 Grupos pequeños',
      price: '16 €/pers.',
      friendsCount: 6,
      img: '/img/group-toast.jpg',
      alt: 'Brindis de amigos de cañas en Malasaña',
      tilt: '2.5deg',
    },
  },
  {
    id: 'latina',
    name: 'Tardeo en La Latina',
    count: 15,
    active: false,
    flyerLeft: {
      title: 'Micro Abierto & Tacos',
      vibe: '🌮 Cenas con risas',
      price: '12 €/pers.',
      friendsCount: 4,
      img: '/img/event-comedy.jpg',
      alt: 'Cómico actuando ante el público en local pequeño',
      tilt: '-3deg',
    },
    flyerRight: {
      title: 'Cañas & Cava Baja',
      vibe: '💸 Plan barato',
      price: '10 €/pers.',
      friendsCount: 5,
      img: '/img/venue-host.jpg',
      alt: 'Taberna castiza en La Latina con ambiente',
      tilt: '3deg',
    },
  },
  {
    id: 'musica',
    name: 'Copas & Música en Vivo',
    count: 14,
    active: false,
    flyerLeft: {
      title: 'Jazz Club & Cócteles',
      vibe: '🎷 Directo íntimo',
      price: '15 €/pers.',
      friendsCount: 4,
      img: '/img/event-acoustic.jpg',
      alt: 'Club de jazz con cócteles de autor',
      tilt: '-2deg',
    },
    flyerRight: {
      title: 'DJ Set en Azotea Secreta',
      vibe: '🪩 Hasta las 03:00',
      price: '18 €/pers.',
      friendsCount: 7,
      img: '/img/mockup-rooftop.jpg',
      alt: 'Sesión de música electrónica en azotea',
      tilt: '3.5deg',
    },
  },
  {
    id: 'brunch',
    name: 'Brunch de Domingo',
    count: 9,
    active: false,
    flyerLeft: {
      title: 'Brunch Botánico Invernadero',
      vibe: '🥐 Masa madre & café',
      price: '18 €/pers.',
      friendsCount: 6,
      img: '/img/event-brunch.jpg',
      alt: 'Mesa de brunch en patio con plantas',
      tilt: '-3deg',
    },
    flyerRight: {
      title: 'Patio Histórico & Mimosas',
      vibe: '🌿 Estilo chill',
      price: '20 €/pers.',
      friendsCount: 5,
      img: '/img/group-toast.jpg',
      alt: 'Amigos disfrutando un brunch al sol',
      tilt: '2.5deg',
    },
  },
];

const steps = [
  {
    title: '1. Elige o propón los finalistas',
    text: 'Explora terrazas, cócteles o picoteo en tu zona y añade 2 o 3 opciones a la votación en 15 segundos.',
  },
  {
    title: '2. Pasa el enlace al grupo de WhatsApp',
    text: 'Tus amigos abren el link en cualquier navegador y votan con un toque. Sin descargar apps ni crear cuentas obligatorias.',
  },
  {
    title: '3. Plan cerrado y ruta lista',
    text: 'La opción más votada gana al cumplirse el tiempo. Todos reciben el punto de encuentro en Google Maps y la hora fijada.',
  },
];
---

<Base>
  <a class="sr-only" href="#top">Saltar al contenido</a>

  <header class="nav">
    <div class="nav__bar">
      <a class="nav__logo" href="#top">
        <span class="mark mark--initial" aria-hidden="true">M</span>Melia
      </a>
      <nav class="nav__links" aria-label="Principal">
        <a class="nav__link" href="#votar">Votación en vivo</a>
        <a class="nav__link" href="#como-funciona">Cómo funciona</a>
        <a class="nav__link" href="#noche">Planes de hoy</a>
      </nav>
      <div class="nav__actions">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Cambiar entre tema claro y oscuro"
          title="Cambiar tema"
          class="theme-toggle-btn"
        >
          <!-- Sun Icon (visible en modo oscuro para volver a claro) -->
          <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="2" x2="12" y2="5"></line>
            <line x1="12" y1="19" x2="12" y2="22"></line>
            <line x1="2" y1="12" x2="5" y2="12"></line>
            <line x1="19" y1="12" x2="22" y2="12"></line>
            <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"></line>
            <line x1="16.95" y1="16.95" x2="19.07" y2="19.07"></line>
            <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"></line>
            <line x1="16.95" y1="7.05" x2="19.07" y2="4.93"></line>
          </svg>
          <!-- Moon Icon (visible en modo claro para pasar a oscuro) -->
          <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
        <a class="btn btn--primary" href="#descargar">Descargar gratis</a>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- HERO · Rootline Hero (HorizonX) with atmospheric spotlight & glowing cables -->
    <section class="section section--hero hero hero--split relative overflow-hidden bg-[var(--p-bg)] transition-colors duration-300" id="descubrir">
      <!-- 1. ATMÓSFERA: Haz de luz cenital + Grilla radial -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <!-- Spotlight superior cónico -->
        <div class="kinetic-spotlight absolute -top-36 left-1/2 -translate-x-1/2 w-[900px] h-[520px] bg-gradient-to-b from-orange-500/25 via-orange-600/5 to-transparent blur-[90px] rounded-full"></div>
        <!-- Resplandor cálido detrás del widget -->
        <div class="absolute top-10 right-[5%] w-[520px] h-[520px] rounded-full bg-orange-500/15 blur-[120px]"></div>
        <!-- Patrón de cuadrícula en perspectiva con máscara radial -->
        <div class="hero-rootline-grid absolute inset-0 opacity-[0.14]"></div>
      </div>

      <div class="wrap grid hero-text hero-split relative z-10">
        <div class="hero-copy span-6 flex flex-col items-start">
          <div class="kinetic-badge hero-badge inline-flex w-fit items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold mb-4 shadow-sm transition-colors duration-300">
            <span class="w-2 h-2 rounded-full bg-orange-600 animate-ping"></span>
            <span>Planes grupales en 30 segundos</span>
          </div>

          <h1 class="text-5xl sm:text-6xl xl:text-[76px] font-black tracking-tighter text-[var(--p-ink)] leading-[0.96] transition-colors duration-200">
            <span class="kinetic-less block text-2xl sm:text-3xl xl:text-[42px] font-black text-[var(--p-ink)] tracking-tight leading-none mb-1">
              Menos
            </span>
            <span class="kinetic-quote relative inline-block w-fit text-3xl sm:text-4xl xl:text-[54px] font-black text-[var(--p-ink)] tracking-tight my-1">
              “a ver qué hacemos”,
              <span class="kinetic-strike" style="position: absolute; left: -4px; right: -4px; top: 52%; height: 7px; background: #ff5a36; border-radius: 9999px; box-shadow: 0 1px 2px rgba(0,0,0,0.18); pointer-events: none;"></span>
            </span>
            <span class="kinetic-more block text-2xl sm:text-3xl xl:text-[42px] font-black text-[var(--p-ink)] tracking-tight leading-none mt-2 mb-1">
              más
            </span>
            <span class="kinetic-punchline block bg-gradient-to-r from-orange-500 via-orange-600 to-amber-500 bg-clip-text text-transparent mt-1 tracking-tighter leading-[0.92] drop-shadow-sm">
              ¡ya estamos aquí!
            </span>
          </h1>

          <p class="kinetic-desc mt-6 text-base sm:text-lg text-[var(--p-muted)] max-w-md leading-relaxed text-left transition-colors duration-200">
            Elige 2 o 3 opciones, manda el link al grupo y voten en 30 segundos. <strong class="text-[var(--p-ink)] font-bold">Sin descargar apps</strong>, sin crear cuentas y sin debates eternos.
          </p>

          <div class="kinetic-buttons mt-8 flex flex-wrap items-center gap-3.5">
            <button
              type="button"
              id="hero-create-btn"
              class="relative group px-7 py-4 rounded-2xl bg-gradient-to-b from-orange-500 to-orange-600 hover:from-orange-400 hover:to-orange-500 text-white font-extrabold text-base shadow-[0_0_35px_rgba(249,115,22,0.45),inset_0_1px_0_rgba(255,255,255,0.4)] transition-all cursor-pointer active:scale-95 inline-flex items-center gap-2"
            >
              <span style="color: #ffffff !important; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35); font-weight: 800;">Crear plan con amigos ✨</span>
            </button>
            <a
              href="#como-funciona"
              class="hero-btn-secondary px-6 py-4 rounded-2xl font-bold text-base transition-colors shadow-sm inline-flex items-center justify-center"
            >
              Ver cómo funciona
            </a>
          </div>

          <div class="kinetic-proof mt-9 flex items-center gap-3.5">
            <div class="flex -space-x-2.5 shrink-0">
              <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Sofia&backgroundColor=ffdfbf" alt="Sofía" class="w-9 h-9 rounded-full border-2 border-[var(--p-bg)] object-cover" />
              <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Marcos&backgroundColor=c0aede" alt="Marcos" class="w-9 h-9 rounded-full border-2 border-[var(--p-bg)] object-cover" />
              <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Ana&backgroundColor=b6e3f4" alt="Ana" class="w-9 h-9 rounded-full border-2 border-[var(--p-bg)] object-cover" />
              <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Leo&backgroundColor=ffd5dc" alt="Leo" class="w-9 h-9 rounded-full border-2 border-[var(--p-bg)] object-cover" />
              <span class="w-9 h-9 rounded-full bg-[var(--p-surface)] text-[var(--p-ink)] text-[11px] font-black flex items-center justify-center border-2 border-[var(--p-bg)]">
                +1.4k
              </span>
            </div>
            <p class="text-xs sm:text-sm text-[var(--p-muted)] leading-snug flex-1 min-w-0 text-left transition-colors duration-200">
              Más de <strong class="text-[var(--p-ink)] font-bold">1.420 planes cerrados</strong> esta semana en Madrid y Barcelona sin discusiones.
            </p>
          </div>
        </div>

        <div class="hero-visual kinetic-widget span-6 relative py-4 sm:py-6">
          <!-- CABLES LUMINOSOS SVG (Rootlines de HorizonX con pulsos de luz) -->
          <svg class="hero-rootlines-svg pointer-events-none absolute -inset-16 w-[calc(100%+128px)] h-[calc(100%+128px)] z-20 overflow-visible" viewBox="0 0 640 700" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="rootline-glow-orange" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FF5A36" stop-opacity="0.3" />
                <stop offset="50%" stop-color="#FF5A36" stop-opacity="1" />
                <stop offset="100%" stop-color="#FBBF24" stop-opacity="0.6" />
              </linearGradient>
              <linearGradient id="rootline-glow-emerald" x1="100%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.4" />
                <stop offset="50%" stop-color="#10B981" stop-opacity="1" />
                <stop offset="100%" stop-color="#FF5A36" stop-opacity="0.6" />
              </linearGradient>
              <filter id="neon-glow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="3.5" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>
            <!-- Cable 1: WhatsApp (Arriba Izq) -> Rim Izquierdo -->
            <path d="M 50 45 C 30 75, 45 110, 87 115" stroke="url(#rootline-glow-orange)" stroke-width="2.5" stroke-dasharray="6 6" class="animate-dash" filter="url(#neon-glow)" />
            <circle cx="87" cy="115" r="4" fill="#FF5A36" filter="url(#neon-glow)" />

            <!-- Cable 2: Pin Votan sin app (Arriba Der) -> Rim Derecho -->
            <path d="M 545 55 C 575 80, 565 115, 526 125" stroke="url(#rootline-glow-emerald)" stroke-width="2.5" stroke-dasharray="6 6" class="animate-dash" filter="url(#neon-glow)" />
            <circle cx="526" cy="125" r="4" fill="#10B981" filter="url(#neon-glow)" />

            <!-- Cable 3: Votos en vivo (Abajo Izq) -> Rim Inferior -->
            <path d="M 70 635 C 45 615, 55 580, 87 560" stroke="url(#rootline-glow-orange)" stroke-width="2.5" stroke-dasharray="6 6" class="animate-dash" filter="url(#neon-glow)" />
            <circle cx="87" cy="560" r="4" fill="#FF5A36" filter="url(#neon-glow)" />
          </svg>

          <!-- NODO SATÉLITE 1: WhatsApp flotando arriba-izquierda -->
          <div class="satellite-node satellite-node--1 hidden sm:flex items-center gap-2.5 absolute -top-4 -left-4 xl:-left-6 z-20 px-3.5 py-2.5 rounded-2xl animate-float-slow">
            <span class="w-7 h-7 rounded-full bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-xs">💬</span>
            <div class="text-left">
              <p class="text-[11px] font-bold leading-tight">Link enviado al grupo</p>
              <p class="text-[10px] text-emerald-500 font-mono font-semibold">melia.app/v/viernes</p>
            </div>
          </div>

          <!-- NODO SATÉLITE 2: Pin destino flotando arriba-derecha -->
          <div class="satellite-node satellite-node--2 hidden sm:flex items-center gap-2 absolute top-2 -right-3 xl:-right-5 z-20 px-3.5 py-2 rounded-2xl animate-float-delayed">
            <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
            <span class="text-xs font-extrabold text-orange-500">⚡ Votan sin app</span>
          </div>

          <!-- NODO SATÉLITE 3: Contador en vivo flotando abajo-izquierda -->
          <div class="satellite-node satellite-node--3 hidden sm:flex items-center gap-2 absolute -bottom-4 left-1 xl:left-3 z-20 px-3.5 py-2 rounded-full animate-float-delayed">
            <span class="text-sm">🔥</span>
            <span class="text-xs font-bold">+3 amigos votando ahora</span>
          </div>

          <!-- Stage for livestream-style floating emojis -->
          <div id="emoji-stage" class="pointer-events-none absolute inset-0 overflow-visible z-30"></div>

          <!-- 3D TILT WRAPPER & CENTRAL BALLOT WIDGET -->
          <div id="poll-card-tilt" class="poll-card-tilt-wrap relative z-10 w-full transition-transform duration-200 ease-out">
            <div class="ballot-widget" id="votar" role="region" aria-label="Widget interactivo de Melia">
              <!-- Floating confetti & emojis layer -->
              <div class="confetti-layer" id="confetti-layer" aria-hidden="true"></div>

              <!-- STATE 1: DEMO VIVA (DEFAULT) -->
              <div class="ballot-view" id="view-demo" data-active="true">
                <div class="flex items-center justify-between gap-2 pb-3 border-b border-neutral-200">
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-emerald-700 text-[11px] font-extrabold">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                      EN VIVO
                    </span>
                  <span class="text-xs font-semibold text-neutral-500">#viernes-madrid (5 amigos)</span>
                </div>
                <span class="font-mono text-xs font-bold bg-neutral-100 text-neutral-800 px-2.5 py-1 rounded-lg border border-neutral-200" id="ballot-timer">14:58 restantes</span>
              </div>

              <div>
                <h2 class="text-xl sm:text-2xl font-black text-[#141414] tracking-tight mt-1" id="poll-title-heading">¿A dónde salimos hoy?</h2>
                <p class="text-xs text-neutral-500 mt-0.5">Tu grupo tiene 15 min para desempatar. Toca para votar:</p>
              </div>

              <div class="ballot__options" id="ballot-options">
                <!-- Option 1 -->
                <div class="ballot__opt border-2 border-neutral-200 rounded-2xl p-3.5 transition-all cursor-pointer hover:border-orange-500" data-option="cibeles" data-leader="true" tabindex="0" role="button" aria-pressed="false" id="opt-cibeles">
                  <div class="ballot__opt-top flex items-center justify-between">
                    <div class="ballot__opt-title font-extrabold text-sm sm:text-base text-[#141414] flex items-center gap-2">
                      <span id="opt-cibeles-title">🍸 Rooftop Cibeles</span>
                    </div>
                    <span class="text-xs text-neutral-500 font-medium">Gran Vía · 15 €/pers.</span>
                  </div>
                  <div class="w-full h-2.5 bg-neutral-200/80 rounded-full mt-2.5 overflow-hidden">
                    <div class="h-full bg-orange-500 rounded-full transition-all duration-500" id="bar-cibeles" style="width: 60%"></div>
                  </div>
                  <div class="flex items-center justify-between mt-2.5 text-xs">
                    <div class="flex -space-x-1.5" id="avs-cibeles">
                      <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Sofia&backgroundColor=ffdfbf" class="w-6 h-6 rounded-full border border-white" alt="Sofía" />
                      <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Marcos&backgroundColor=c0aede" class="w-6 h-6 rounded-full border border-white" alt="Marcos" />
                      <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Ana&backgroundColor=b6e3f4" class="w-6 h-6 rounded-full border border-white" alt="Ana" />
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-neutral-600" id="count-cibeles">3 votos (60%)</span>
                      <span class="px-3 py-1 rounded-lg bg-[#141414] text-white text-xs font-bold transition-colors" id="btn-cibeles">Votar</span>
                    </div>
                  </div>
                </div>

                <!-- Option 2 -->
                <div class="ballot__opt border-2 border-neutral-200 rounded-2xl p-3.5 transition-all cursor-pointer hover:border-orange-400 bg-white" data-option="malasana" data-leader="false" tabindex="0" role="button" aria-pressed="false" id="opt-malasana">
                  <div class="ballot__opt-top flex items-center justify-between">
                    <div class="ballot__opt-title font-extrabold text-sm sm:text-base text-[#141414] flex items-center gap-2">
                      <span id="opt-malasana-title">🌮 Tacos & Acústico</span>
                    </div>
                    <span class="text-xs text-neutral-500 font-medium">Malasaña · 12 €/pers.</span>
                  </div>
                  <div class="w-full h-2.5 bg-neutral-200/80 rounded-full mt-2.5 overflow-hidden">
                    <div class="h-full bg-neutral-400 rounded-full transition-all duration-500" id="bar-malasana" style="width: 40%"></div>
                  </div>
                  <div class="flex items-center justify-between mt-2.5 text-xs">
                    <div class="flex -space-x-1.5" id="avs-malasana">
                      <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Leo&backgroundColor=ffd5dc" class="w-6 h-6 rounded-full border border-white" alt="Laura" />
                      <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Carla&backgroundColor=d1d4f9" class="w-6 h-6 rounded-full border border-white" alt="Carlos" />
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-neutral-600" id="count-malasana">2 votos (40%)</span>
                      <span class="px-3 py-1 rounded-lg bg-neutral-100 text-[#141414] text-xs font-bold transition-colors border border-neutral-200" id="btn-malasana">Votar</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Reacciones rápidas con explosión de emojis -->
              <div class="mt-3 pt-3 border-t border-neutral-200 flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center gap-1.5">
                  <span class="text-xs text-neutral-500 mr-1 font-semibold">Reaccionar:</span>
                  <button type="button" data-emoji="🔥" class="vibe-btn emoji-btn px-2.5 py-1 rounded-full bg-orange-50 hover:bg-orange-100 border border-orange-200 text-xs font-bold text-orange-800 cursor-pointer active:scale-90 transition-transform">🔥 Fiestón</button>
                  <button type="button" data-emoji="🍸" class="vibe-btn emoji-btn px-2.5 py-1 rounded-full bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-xs font-bold text-neutral-700 cursor-pointer active:scale-90 transition-transform">🍸 Chill</button>
                  <button type="button" data-emoji="💸" class="vibe-btn emoji-btn px-2.5 py-1 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-xs font-bold text-emerald-800 cursor-pointer active:scale-90 transition-transform">💸 Barato</button>
                </div>
              </div>

              <!-- Post-vote feedback toast -->
              <div class="ballot__toast" id="ballot-toast" style="display:none;">
                <span>🎉</span>
                <span id="toast-msg">¡Voto registrado! Cero apps, cero registros para tus amigos.</span>
              </div>

              <div class="mt-3 pt-3 border-t border-neutral-200 flex items-center justify-between text-xs">
                <span id="poll-footer-msg" class="text-neutral-500">Compartido por Marcos vía WhatsApp</span>
                <button type="button" id="btn-to-creator" class="font-black text-orange-600 hover:text-orange-700 cursor-pointer">
                  ✨ Probar crear el mío →
                </button>
              </div>
            </div>

            <!-- STATE 2: MODO CREADOR (ZERO-FRICTION SANDBOX) -->
            <div class="ballot-view" id="view-creator" data-active="false">
