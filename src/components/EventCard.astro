---
import Icon from './Icon.astro';

interface Props {
  image: string;
  alt: string;
  category: string;
  badge: string;
  time: string;
  price: string;
  title: string;
  description: string;
  location: string;
  featured?: boolean;
}

const {
  image,
  alt,
  category,
  badge,
  time,
  price,
  title,
  description,
  location,
  featured = false,
} = Astro.props;
---

<article
  class:list={[
    'group flex flex-col overflow-hidden rounded-card border border-rule bg-paper-2',
    featured && 'h-full',
  ]}
>
  <div class:list={['relative w-full overflow-hidden', featured ? 'h-full min-h-[220px] flex-1' : 'h-52']}>
    <img alt={alt} class="h-full w-full object-cover" src={image} />
    <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-2 p-3">
      <span class="rounded-pill bg-paper/85 px-2.5 py-1 text-xs font-medium text-ink"
        >{category}</span
      >
      <button
        type="button"
        aria-label={`Guardar en favoritos: ${title}`}
        class="flex h-8 w-8 items-center justify-center rounded-pill border border-rule bg-paper/85 text-ink-2 transition-colors hover:text-accent-text"
      >
        <Icon name="favorite_border" class="text-[17px]" />
      </button>
    </div>
    <span
      class="absolute bottom-3 left-3 rounded-pill bg-accent px-2.5 py-0.5 text-xs font-medium text-accent-ink"
      >{badge}</span
    >
  </div>

  <div class="flex flex-1 flex-col justify-between gap-3 p-[var(--space-lg)]">
    <div class="flex flex-col gap-1.5">
      <div class="flex items-baseline justify-between gap-3 text-xs text-muted">
        <span>{time}</span>
        <span class="num text-base text-ink">{price}</span>
      </div>
      <h3 class="text-lg text-ink transition-colors group-hover:text-accent-text">
        {title}
      </h3>
      <p class="text-sm text-ink-2">{description}</p>
    </div>
    <div class="flex items-center justify-between gap-3 border-t border-rule pt-3">
      <span class="flex items-center gap-1 text-xs text-ink-2">
        <Icon name="location_on" class="text-[15px] text-accent-text" />
        {location}
      </span>
      <a
        class="whitespace-nowrap rounded-pill border border-ink-2 px-4 py-2.5 text-xs font-medium text-ink-2 transition-colors hover:border-accent hover:text-accent-text"
        href="#mapa-en-vivo">Ver plan</a
      >
    </div>
  </div>
</article>
